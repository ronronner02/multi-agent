{
  "name": "multi-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop window for Multi-Agent, running the engine as its own native child process",
  "license": "Apache-2.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/stage-engine.mjs && node scripts/stage-gh.mjs",
    "stage": "npm run build",
    "stage:check": "node scripts/stage-engine.mjs --check && node scripts/stage-gh.mjs --check",
    "test": "node --test test/*.test.js",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "unzipper": "^0.12.5"
  }
}