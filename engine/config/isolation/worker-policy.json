{
  "schema": "multi-agent-worker-policy/v1",
  "policy_revision": 3,
  "control_identity": "ma-control",
  "egress_identity": "ma-egress",
  "launch_callers": [
    "ma-control"
  ],
  "worker_identities": [
    "ma-worker1",
    "ma-worker2",
    "ma-worker3"
  ],
  "forbidden_worker_groups": [
    "root",
    "sudo",
    "adm",
    "admin",
    "wheel",
    "docker",
    "lxd",
    "disk",
    "ma-control",
    "ma-egress"
  ],
  "paths": {
    "state_root": "/var/lib/multi-agent",
    "control_state_dir": "/var/lib/multi-agent/control",
    "worker_root": "/var/lib/multi-agent/workers",
    "assignment_root": "/var/lib/multi-agent/assignments",
    "toolchain_dir": "/opt/multi-agent/toolchain",
    "framework_dir": "/opt/multi-agent/framework",
    "installed_launcher": "/usr/local/libexec/multi-agent/worker-launch.mjs",
    "installed_policy": "/etc/multi-agent/worker-policy.json",
    "installed_egress": "/opt/multi-agent/toolchain/egress/egress.mjs",
    "installed_egress_config": "/etc/multi-agent/egress.json",
    "egress_socket_dir": "/run/multi-agent-egress"
  },
  "sandbox": {
    "home": "/home/worker",
    "scratch": "/scratch",
    "work": "/work",
    "framework": "/framework",
    "hostname": "ma-sandbox",
    "network": "filtered-proxy",
    "egress_port": 3128,
    "interactive_tty": true,
    "require_legacy_tiocsti_disabled": true,
    "path": "/opt/multi-agent/toolchain/clients/bin:/opt/multi-agent/toolchain/node/bin:/usr/bin",
    "masked_paths": [
      "/usr/lib/wsl"
    ],
    "etc_ro_binds": [
      "/etc/passwd",
      "/etc/group",
      "/etc/nsswitch.conf",
      "/etc/hosts",
      "/etc/resolv.conf",
      "/etc/localtime",
      "/etc/ssl",
      "/etc/ca-certificates",
      "/etc/alternatives",
      "/etc/ld.so.cache",
      "/etc/ld.so.conf",
      "/etc/ld.so.conf.d"
    ]
  },
  "roles": {
    "implementer": {
      "work_tree": "rw"
    },
    "reviewer": {
      "work_tree": "ro"
    }
  },
  "env_passthrough": [
    "TERM",
    "COLORTERM",
    "LANG",
    "LC_ALL"
  ],
  "allowed_exec_prefixes": [
    "/opt/multi-agent/toolchain/",
    "/usr/bin/"
  ]
}
